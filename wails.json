{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "AgentDesk",
  "outputfilename": "AgentDesk",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "author": {
    "name": "Waruna de Silva",
    "email": "warunacds@gmail.com"
  },
  "info": {
    "companyName": "Agent Desk",
    "productName": "Agent Desk",
    "productVersion": "0.5.0",
    "copyright": "Copyright 2026 Waruna de Silva",
    "comments": "AI agent skill file manager",
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown Document",
        "description": "Markdown file",
        "iconName": "appicon",
        "role": "Editor"
      },
      {
        "ext": "mdc",
        "name": "Cursor Rules File",
        "description": "MDC rules file",
        "iconName": "appicon",
        "role": "Editor"
      }
    ]
  }
}
